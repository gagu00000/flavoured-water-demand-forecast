{
  "name": "flavoured-water-forecast-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive demand-forecasting dashboard for a new flavoured water (AI in Operations lab).",
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "dev": "npm run sync && vite",
    "build": "npm run sync && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:parity": "vitest run tests/parity",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "echarts": "^6.1.0",
    "framer-motion": "^14.12.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.1",
    "@playwright/test": "1.65",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "pyodide": "0.29.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
